///////////
Find the First Unsorted Element in an Array




public class Main
{
    static int display(int arr[]){
        
        for(int i=0; i<arr.length-1; i++){
            if(arr[i+1] <= arr[i]){
                
             return arr[i+1];
            }
           
        }
         return -1;
    }
	public static void main(String[] args) {
	    
	    int arr[] = {1,2,5,4,9};
	    int ans = display(arr);
	    System.out.println(ans);

	}
}
