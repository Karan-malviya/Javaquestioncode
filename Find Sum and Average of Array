// Find Sum and Average of Array
public class Main
{
	public static void main(String[] args) {

 int arr[] ={2,4,6,8};
 int sum = 0;
 
 int avg=0;
 
 for(int i=0; i<arr.length;i++){
     
     int digit = arr[i];
     
     sum = sum +digit;
     avg = sum / arr.length;
     
 }
 
 System.out.println(avg);
 
 

	}
}
