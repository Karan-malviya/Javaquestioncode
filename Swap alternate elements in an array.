////////////////////////
✅ Swap alternate elements in an array.
///simple way 
public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 40, 50, 60};

        for (int i = 0; i < arr.length - 1; i += 2) {

            int temp = arr[i];
            arr[i] = arr[i + 1];
            arr[i + 1] = temp;
        }

        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}

