public class Main {

    static boolean search(int[] num, int target) {

        for (int i = 0; i < num.length; i++) {

            if (num[i] == target) {
                return true;
            }
        }

        return false;
    }

    public static void main(String[] args) {

        int[] num = {1, 2, 3, 4, 5};
        int target = 4;

        System.out.println(search(num, target));
    }
}
