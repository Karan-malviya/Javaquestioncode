///// second largest array find it 

public class Main
{
	public static void main(String[] args) {
	  int arr[] = {2,8,4,7,6};
	  
	  int max=arr[0];
	  
	  int secondmax=0;
	  
	  for(int i=0 ;i<arr.length; i++){
	      
	      if(arr[i] > max){
	          
	          secondmax = max;
	          max = arr[i];
	      }
	      else if(arr[i] > secondmax){
	          secondmax = arr[i];
	      }
	  }
	  System.out.println(secondmax);
	}
}
