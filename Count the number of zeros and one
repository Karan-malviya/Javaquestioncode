///////////////////////////
Count the number of zeros and one 


public class Main
{
    static double[] display(double arr[]){
        
       int zerosocunt=0;
       int onescount=0;
       
        
        for(int i=0; i<arr.length; i++){
            
            if(arr[i] == 0){
                zerosocunt++;
                
            }else {
                onescount++;
            }
        }
        double ans[]={zerosocunt,onescount};
        return ans;
    }
	public static void main(String[] args) {
	 
	 double arr[] = {0,1,0,1,1,0,1};
	 double ans[] = display(arr);
	 System.out.println("zerosocunt " + ans[0]);
	 System.out.println("onescount" + ans[1]);
	}
}
